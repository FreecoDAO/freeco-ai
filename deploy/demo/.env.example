# Copy to .env and fill in. The stack refuses to start without the passwords,
# which is deliberate: a demo that boots with default credentials is a demo
# that gets left running on a public IP with default credentials.
#
#   cp .env.example .env
#   # generate real values:
#   openssl rand -base64 24     # for each password/secret below

# ---- Required ---------------------------------------------------------
TWENTY_DB_PASSWORD=
TWENTY_APP_SECRET=
AKAUNTING_DB_PASSWORD=

# ---- Public URLs ------------------------------------------------------
# Set these to the real hostnames before showing anyone. Both apps build
# links from them, so left at localhost the login flows break for every
# visitor who is not sitting at the server.
TWENTY_URL=http://localhost:3200
AKAUNTING_URL=http://localhost:8080

# ---- Model provider ---------------------------------------------------
# One is enough. Leave the rest blank rather than filling with placeholders:
# a non-empty dummy value looks like a working key and fails at request time
# instead of at startup.
OPENROUTER_API_KEY=
ZHIPU_API_KEY=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
